/**
 * 定位业务编排（壳侧）。
 *
 * 对上：对接 Vue 已写好的 5 个方法，方法名/参数/回传格式完全按 bridge/protocol.uts。
 * 对下：调用 uni_modules/tdyb-amap-location（高德 SDK）。
 *
 * 前端传参（都在 message 里，没有就取默认值）：
 *   interval      持续定位回传节奏 ms（钳制 1000~10000）
 *   type/coordType  'wgs84' | 'gcj02'，默认 wgs84
 *   geocode/needAddress  是否反地理编码，默认 false
 */

import {
	DEFAULT_INTERVAL,
	MIN_INTERVAL,
	MAX_INTERVAL,
	ONCE_TIMEOUT,
	AMAP_KEY
} from '@/utils/config.uts'
import { COORD_WGS84, COORD_GCJ02 } from './protocol.uts'
import { replyJson, replyError, replyText } from './reply.uts'
import { gcj02ToWgs84, distanceM } from '@/utils/coord.uts'
import {
	once as amapOnce,
	start as amapStart,
	stop as amapStop,
	destroy as amapDestroy,
	requestPermission,
	requestNotificationPermission,
	setKey as amapSetKey,
	prepare as amapPrepare,
	enableBackground,
	disableBackground,
	checkBackgroundPermission,
	requestBackgroundPermission,
	isIgnoringBatteryOptimizations,
	requestIgnoreBatteryOptimizations,
	TdybAmapLocation,
	TdybAmapError
} from '@/uni_modules/tdyb-amap-location'

/* ------------------------------ 状态 ------------------------------ */

let streaming : boolean = false
let streamKey : string = ""
let streamCoord : string = COORD_WGS84
let streamInterval : number = DEFAULT_INTERVAL
let lastLng : number = 0.0
let lastLat : number = 0.0
let lastSentAt : number = 0
let lastFix : TdybAmapLocation | null = null
/** 最近一次拿到定位的时间，用于「3 秒内直接复用」，避免点定位重复起 SDK */
let lastFixAt : number = 0
/** 权限已授予后不再重复申请，省掉一次系统调用往返 */
let permGranted : boolean = false

/** 预热高德 SDK（页面就绪时调一次，只建 client，不启动定位） */
export function warmUp() : void {
	try {
		if (AMAP_KEY != "") amapSetKey(AMAP_KEY)
		amapPrepare()
	} catch (e) {
		console.warn("[TDYB] 高德预热失败（插件可能没打进基座）")
	}
}

/** 只在没授权时才真正申请；已授权直接放行 */
function ensurePermission() : Promise<boolean> {
	// 注意：UTS 的 then 回调要求返回 Unit（不能 return 值），所以用外层 Promise 自己 resolve
	return new Promise((resolve, _reject) => {
		if (permGranted) {
			resolve(true)
			return
		}
		requestPermission().then((ok : boolean) => {
			if (ok) permGranted = true
			resolve(ok)
		})
	})
}

/* ------------------------------ 参数读取 ------------------------------ */

function readString(obj : UTSJSONObject | null, key : string, def : string) : string {
	if (obj == null) return def
	const v = obj.getString(key)
	if (v == null) return def
	return v!
}

function readBool(obj : UTSJSONObject | null, key : string, def : boolean) : boolean {
	if (obj == null) return def
	const v = obj.getBoolean(key)
	if (v == null) return def
	return v!
}

function readNumber(obj : UTSJSONObject | null, key : string, def : number) : number {
	if (obj == null) return def
	const v = obj.getNumber(key)
	if (v == null) return def
	return v!
}

function readCoord(obj : UTSJSONObject | null) : string {
	let v = readString(obj, "type", "")
	if (v == "") v = readString(obj, "coordType", "")
	if (v == COORD_GCJ02) return COORD_GCJ02
	return COORD_WGS84
}

function clampInterval(v : number) : number {
	if (v < MIN_INTERVAL) return MIN_INTERVAL
	if (v > MAX_INTERVAL) return MAX_INTERVAL
	return v
}

/* ------------------------------ 结果组装 ------------------------------ */

/** 转成 Vue 侧 normalizeLocation 认识的扁平结构（顶层必须有 longitude/latitude） */
function buildFix(loc : TdybAmapLocation, coord : string) : UTSJSONObject {
	let lng = loc.longitude
	let lat = loc.latitude
	if (coord == COORD_WGS84) {
		const p = gcj02ToWgs84(lat, lng)
		lat = p.latitude
		lng = p.longitude
	}

	const coords : UTSJSONObject = {
		"latitude": lat,
		"longitude": lng,
		"accuracy": loc.accuracy,
		"altitude": loc.altitude,
		"speed": loc.speed
	}
	const wgs84 : UTSJSONObject = {
		"latitude": lat,
		"longitude": lng
	}

	const out : UTSJSONObject = {
		"longitude": lng,
		"latitude": lat,
		"altitude": loc.altitude,
		"accuracy": loc.accuracy,
		"speed": loc.speed,
		"bearing": loc.bearing,
		"coordType": coord,
		"coordsType": coord,
		"fixStatus": "gps",
		"provider": "amap",
		"locationType": loc.locationType,
		"timestamp": loc.time,
		"errorCode": 0,
		"address": loc.address,
		"province": loc.province,
		"city": loc.city,
		"district": loc.district,
		"street": loc.street,
		"poiName": loc.poiName,
		"coords": coords,
		"wgs84": wgs84
	}
	return out
}

/* ------------------------------ 单次定位 ------------------------------ */

/**
 * 持续定位在跑时，点「定位」直接复用最近 5 秒内的结果。
 * 既不用重新起 SDK，也不会打断自动记录。
 */
function replyFreshIfStreaming(key : string, coord : string) : boolean {
	if (!streaming) return false
	const fix = lastFix
	if (fix == null) return false
	if (Date.now() - lastSentAt > 5000) return false
	replyJson(key, buildFix(fix!, coord))
	return true
}

/**
 * Vue：getPreciseLocation({ type:'wgs84', geocode:true, success, fail })
 * 优化后的策略（按速度优先）：
 *   1) 3 秒内刚定位过 → 直接复用缓存，秒回
 *   2) 不等高德的「3 秒内最优」→ onceLatest=false，取第一帧
 *   3) 反地理编码只在前端明确要 geocode 时才做
 *   4) 权限已授予时不再重复申请
 */
export function handlePrecise(message : UTSJSONObject | null, key : string) : void {
	const t0 = Date.now()
	const coord = readCoord(message)
	const needAddress = readBool(message, "geocode", readBool(message, "needAddress", false))

	if (replyFreshIfStreaming(key, coord)) return

	// 3 秒内刚定位过 → 直接给缓存，点一下秒回
	const cachedNow = lastFix
	if (cachedNow != null && Date.now() - lastFixAt <= 3000) {
		replyJson(key, buildFix(cachedNow!, coord))
		console.log("[TDYB] 单次定位命中缓存 " + (Date.now() - t0).toString() + "ms")
		return
	}

	ensurePermission().then((ok : boolean) => {
		if (!ok) {
			replyError(key, "未授予定位权限，请在系统设置中允许定位")
			return
		}
		if (AMAP_KEY != "") amapSetKey(AMAP_KEY)

		let done : boolean = false
		const timer = setTimeout(() => {
			if (done) return
			done = true
			const cached = lastFix
			if (cached != null) {
				replyJson(key, buildFix(cached!, coord))
			} else {
				replyError(key, "定位超时，请检查 GPS 与网络后重试")
			}
			console.log("[TDYB] 单次定位超时 " + (Date.now() - t0).toString() + "ms")
		}, ONCE_TIMEOUT)

		amapOnce({
			needAddress: needAddress,
			onceLatest: false,
			httpTimeout: 4000,
			success: (loc : TdybAmapLocation) => {
				if (done) return
				done = true
				clearTimeout(timer)
				lastFix = loc
				lastFixAt = Date.now()
				replyJson(key, buildFix(loc, coord))
				console.log("[TDYB] 单次定位完成 " + (Date.now() - t0).toString() + "ms")
			},
			fail: (e : TdybAmapError) => {
				if (done) return
				done = true
				clearTimeout(timer)
				const cached = lastFix
				if (cached != null) {
					replyJson(key, buildFix(cached!, coord))
				} else {
					replyError(key, e.errMsg)
				}
				console.log("[TDYB] 单次定位失败 " + (Date.now() - t0).toString() + "ms: " + e.errMsg)
			}
		})
	})
}

/**
 * Vue：getLocationQuickly(...) —— 单次定位的兜底通道。
 * 不要求最新结果（允许缓存），超时更短。
 */
export function handleQuick(message : UTSJSONObject | null, key : string) : void {
	const coord = readCoord(message)
	const needAddress = readBool(message, "geocode", false)

	if (replyFreshIfStreaming(key, coord)) return

	ensurePermission().then((ok : boolean) => {
		if (!ok) {
			replyError(key, "未授予定位权限，请在系统设置中允许定位")
			return
		}
		if (AMAP_KEY != "") amapSetKey(AMAP_KEY)

		let done : boolean = false
		const timer = setTimeout(() => {
			if (done) return
			done = true
			const cached = lastFix
			if (cached != null) {
				replyJson(key, buildFix(cached!, coord))
			} else {
				replyError(key, "快速定位超时")
			}
		}, 4000)

		amapOnce({
			needAddress: needAddress,
			onceLatest: false,
			httpTimeout: 3000,
			success: (loc : TdybAmapLocation) => {
				if (done) return
				done = true
				clearTimeout(timer)
				lastFix = loc
				lastFixAt = Date.now()
				replyJson(key, buildFix(loc, coord))
			},
			fail: (e : TdybAmapError) => {
				if (done) return
				done = true
				clearTimeout(timer)
				const cached = lastFix
				if (cached != null) {
					replyJson(key, buildFix(cached!, coord))
				} else {
					replyError(key, e.errMsg)
				}
			}
		})
	})
}

/* ------------------------------ 后台保活引导 ------------------------------ */

let bgAsked : boolean = false
let batteryAsked : boolean = false

/** 引导把定位权限改成「始终允许」；没有它，切后台/锁屏后系统会直接掐掉定位 */
function ensureBackgroundPermission() : void {
	if (checkBackgroundPermission()) return
	if (bgAsked) return
	bgAsked = true
	uni.showModal({
		title: "需要后台定位权限",
		content: "要保证锁屏或切到后台后继续记录轨迹，请把定位权限改为「始终允许」。",
		confirmText: "去设置",
		success: (res) => {
			if (res.confirm) {
				requestBackgroundPermission()
			}
		}
	})
}

/** 安卓电池优化会杀后台进程，引导一次 */
function ensureBatteryOptimization() : void {
	if (batteryAsked) return
	batteryAsked = true
	if (isIgnoringBatteryOptimizations()) return
	uni.showModal({
		title: "后台保活",
		content: "为保证长时间后台定位，请允许本应用忽略电池优化。",
		confirmText: "去设置",
		success: (res) => {
			if (res.confirm) {
				requestIgnoreBatteryOptimizations()
			}
		}
	})
}

/* ------------------------------ 持续定位 ------------------------------ */

/**
 * Vue：startGetLocationService({ success, fail }) + message.interval
 * 每来一条定位就回写一次（同一个 key，Vue 侧 once=false 的 setter 会反复触发）。
 */
export function handleStart(message : UTSJSONObject | null, key : string) : void {
	streamKey = key
	streamCoord = readCoord(message)
	streamInterval = clampInterval(readNumber(message, "interval", DEFAULT_INTERVAL))
	const needAddress = readBool(message, "needAddress", false)

	ensurePermission().then((ok : boolean) => {
		if (!ok) {
			replyError(key, "未授予定位权限，持续定位无法启动")
			return
		}
		if (AMAP_KEY != "") amapSetKey(AMAP_KEY)

		streaming = true
		lastSentAt = 0

		// 顺序很重要：先开后台定位（建前台服务 + 通知），再 startLocation。
		// 反过来（先 start 后 enableBackground）高德可能重置定位服务，导致回调不再上来。
		// 通知权限异步申请，不阻塞启动；Android 13+ 没授权只是通知不显示。
		enableBackground("TDYB 数据采集", "正在后台持续定位，请勿关闭此通知")
		requestNotificationPermission()

		amapStart({
			interval: streamInterval,
			needAddress: needAddress,
			success: (loc : TdybAmapLocation) => {
				onStreamFix(loc)
			},
			fail: (e : TdybAmapError) => {
				replyError(key, e.errMsg)
			}
		})
		console.log("[TDYB] 持续定位已启动 interval=" + streamInterval.toString())

		// 看门狗：5 秒内一条定位都没上来，打个警告方便排查
		setTimeout(() => {
			if (streaming && lastSentAt == 0) {
				console.warn("[TDYB] 持续定位 5 秒内没有收到任何定位回调（检查 GPS/权限/高德 key）")
			}
		}, 5000)

		// 引导放最后，避免弹窗打断上面两步
		ensureBackgroundPermission()
		ensureBatteryOptimization()
	})
}

function onStreamFix(loc : TdybAmapLocation) : void {
	if (!streaming) return

	const now = Date.now()
	const moved = distanceM(lastLat, lastLng, loc.latitude, loc.longitude)
	if (lastSentAt > 0) {
		const elapsed = now - lastSentAt
		// 没到节奏、且几乎没动 → 丢弃，避免把桥淹了
		if (elapsed < streamInterval * 0.8 && moved < 0.5) {
			console.log("[TDYB] 定位流丢弃（节流）acc=" + loc.accuracy.toString())
			return
		}
	}

	lastLng = loc.longitude
	lastLat = loc.latitude
	lastSentAt = now
	lastFix = loc
	lastFixAt = now
	console.log("[TDYB] 定位流回写 acc=" + loc.accuracy.toString() + " " + loc.longitude.toString() + "," + loc.latitude.toString())
	replyJson(streamKey, buildFix(loc, streamCoord))
}

/** Vue：closeGetLocationService() */
export function handleClose(key : string) : void {
	streaming = false
	streamKey = ""
	lastSentAt = 0
	amapStop()
	disableBackground()
	replyText(key, "关闭成功")
	console.log("[TDYB] 持续定位已停止")
}

/* ------------------------------ 设置 / 生命周期 ------------------------------ */

/** Vue：openLocationSetting() —— 新壳只有高德定位，没有 RTK 设置页 */
export function handleOpenSetting(key : string) : void {
	const ok : UTSJSONObject = { "success": true }
	replyJson(key, ok)
	uni.showToast({ title: "当前为高德定位模式", position: "bottom" })
}

export function setMode(mode : string, key : string) : void {
	uni.setStorageSync("LocationMode", mode)
	const ok : UTSJSONObject = { "success": true }
	replyJson(key, ok)
}

export function getMode(key : string) : void {
	// getStorageSync 返回的是可空 Any，先落到 string 再回写，避免 Any? 直接参与表达式
	const mode = uni.getStorageSync("LocationMode")
	let text : string = "GPS"
	if (mode != null) {
		text = mode.toString()
	}
	replyText(key, text)
}

/** 页面销毁时兜底 */
export function stopAll() : void {
	streaming = false
	streamKey = ""
	amapStop()
	disableBackground()
	amapDestroy()
}

/** 当前是否在持续定位（调试用） */
export function isStreaming() : boolean {
	return streaming
}
