/** 定位回传节奏：前端没传 interval 时的默认值（ms） */
export const DEFAULT_INTERVAL = 2000

/** 允许前端传入的 interval 区间（ms），超出即钳制 */
export const MIN_INTERVAL = 1000
export const MAX_INTERVAL = 10000

/** 单次定位整体超时（ms），超时给前端回 fail，避免前端一直转圈 */
export const ONCE_TIMEOUT = 6000

/**
